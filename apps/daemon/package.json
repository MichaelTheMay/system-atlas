    "@atlas/evidence": "workspace:*",
    "@atlas/graph": "workspace:*",
    "@atlas/planner": "workspace:*",
    "@atlas/schema": "workspace:*",
    "@atlas/store": "workspace:*",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  }
}
