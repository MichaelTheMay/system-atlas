{
  "name": "@atlas/daemon",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/server.ts",
    "./main": "./src/main.ts",
    "./discovery": "./src/discovery.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
